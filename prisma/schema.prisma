generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

/// A tenant. Staff belong to one or more of these.
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String   @unique
  createdAt DateTime @default(now())

  /// A holding area for documents from deleted companies. Not a real
  /// tenant: it has no members, it never appears in the admin list or any
  /// company picker, and only super admins can reach its files.
  isArchive Boolean @default(false)

  memberships Membership[]
  folders     Folder[]
  files       File[]
  activities  Activity[]
  deletedAt   DateTime?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships Membership[]
  sessions    Session[]
  activities  Activity[]
  permissions Permission[]
  uploads     File[]        @relation("uploader")
  versions    FileVersion[]
  folders     Folder[]
  shareLinks ShareLink[]
  lastSeenAt DateTime?
}

enum Role {
  VIEWER
  EDITOR
  MANAGER
  ADMIN
}

/// Which people are in which company, and what they may do by default.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Folder {
  id          String    @id @default(cuid())
  companyId   String
  parentId    String?
  name        String
  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      Folder?      @relation("FolderTree", fields: [parentId], references: [id])
  children    Folder[]     @relation("FolderTree")
  createdBy   User?        @relation(fields: [createdById], references: [id])
  files       File[]
  permissions Permission[]

  @@index([companyId, parentId])
}

model File {
  id        String @id @default(cuid())

  companyId String
  folderId  String?
  name      String
  extension String
  size      Int    @default(0)

  /// Bumped on every save. Feeds the OnlyOffice document key.
  version      Int      @default(1)
  storageKey   String
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  archivedFrom String?

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folder      Folder?       @relation(fields: [folderId], references: [id])
  uploadedBy  User?         @relation("uploader", fields: [uploadedById], references: [id])
  versions    FileVersion[]
  permissions Permission[]
  activities  Activity[]
  shareLinks ShareLink[]

  @@index([companyId, folderId])
  /// The Drive's default sort. Without this, pagination still makes Postgres
  /// examine every matching row to decide which 20 come first.
  @@index([updatedAt])
  /// "What has this person created?" — profile page, admin user panel,
  /// and the transfer-files count.
  @@index([uploadedById])
}

model FileVersion {
  id          String   @id @default(cuid())
  fileId      String
  version     Int
  storageKey  String
  size        Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  /// Editing data from OnlyOffice, used to highlight what changed.
  /// Null for versions we created ourselves, such as restores.
  changesKey     String?
  serverVersion  String?
  changesSummary Json?

  file      File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id])

  @@unique([fileId, version])
}

/// A grant on one folder or one file, to one person or to a whole role.
model Permission {
  id       String  @id @default(cuid())
  folderId String?
  fileId   String?
  userId   String?
  role     Role?

  canView     Boolean @default(false)
  canEdit     Boolean @default(false)
  canComment  Boolean @default(false)
  canDownload Boolean @default(false)
  canPrint    Boolean @default(false)
  canDelete   Boolean @default(false)

  createdAt DateTime @default(now())

  folder Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Read on every permission resolution and had no index at all.
  /// resolveFilePermissions queries by fileId, then again by folderId for
  /// each level up the folder tree — five folders deep meant six full table
  /// scans, per file, per request.
  @@index([fileId])
  @@index([folderId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// For clearing expired sessions — nothing does that yet, but it should.
  @@index([expiresAt])
}

model ShareLink {
  id     String @id @default(cuid())
  token  String @unique
  fileId String

  canDownload Boolean @default(false)
  canEdit     Boolean @default(false)

  passwordHash String?
  expiresAt    DateTime?
  revokedAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  file      File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([fileId])
}

/// Append-only. Never build an update or delete route for this table.
model Activity {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String
  fileId    String?
  detail    Json?
  ip        String?
  userAgent String?
  /// The column exists in the database and nothing writes to it. It stays
  /// declared here so the schema and the database agree — dropping it would
  /// need a migration of its own, for no gain.
  location  String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  file    File?    @relation(fields: [fileId], references: [id])

  @@index([companyId, createdAt])
  /// The one above serves an admin scoped to a company. It can't serve a
  /// regular user's page, which filters on userId, nor a super admin's,
  /// which sorts the whole table. This is the fastest-growing table here.
  @@index([userId, createdAt])
  @@index([createdAt])
  /// The login throttle counts LOGIN_FAILED rows in a time window on every
  /// sign-in attempt.
  @@index([action, createdAt])
}
